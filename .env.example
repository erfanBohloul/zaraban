# Copy this file to .env (which is git-ignored) and fill in your own values.

# Proxy used ONLY when a direct download fails during `docker compose build`.
# Leave it empty to use direct downloads only.
#
# Use your VPN app's local HTTP proxy port. Write host.docker.internal, NOT
# 127.0.0.1: inside the build, 127.0.0.1 is the build container itself.
# The VPN app must accept connections from Docker ("Allow LAN" in most apps).
#
# Examples (check the port in your VPN app's settings):
#   BUILD_PROXY=http://host.docker.internal:10809
#   BUILD_PROXY=http://host.docker.internal:7890
BUILD_PROXY=

# Linux only: your user and group ids, so files written in the container are yours.
# HOST_UID=1000
# HOST_GID=1000
