.git
.gitignore

# Python caches and environments
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache
.venv
venv
env
*.egg-info
dist
build

# Zaraban outputs and project content (not needed to build the image)
out/
results/
targets/
tests/
docs/
tmp/

# OS files
.DS_Store
